+// The keyboard's keys, by macOS virtual key code. Entries 0-15 are the buttons in dm_input.h's bit order (the names of DM_HID_MAP), then the sticks' directions and Shake.
+// Defaults: J K U I → A B X Y, F G → press stick, Q E Z C → L R ZL ZR, Return Tab → + −, arrows → D-pad, WASD → left stick, Space → Shake (shaken while held).
+// DM_KEYMAP=<NAME>=<key code>,… replaces entries (-1 unbinds one); a key bound twice does both. Front ends draw it as a key binding screen
+enum { KM_LS_UP = 16, KM_LS_LEFT, KM_LS_DOWN, KM_LS_RIGHT, KM_RS_UP, KM_RS_LEFT, KM_RS_DOWN, KM_RS_RIGHT, KM_SHAKE, KM_N };
+static const char *const km_names[KM_N] = {"A", "B", "X", "Y", "LS", "RS", "L", "R", "ZL", "ZR", "PLUS", "MINUS", "LEFT", "UP", "RIGHT", "DOWN",
+                                           "LS_UP", "LS_LEFT", "LS_DOWN", "LS_RIGHT", "RS_UP", "RS_LEFT", "RS_DOWN", "RS_RIGHT", "SHAKE"};
+static int g_km[KM_N] = {38, 40, 32, 34, 3, 5, 12, 14, 6, 8, 36, 48, 123, 126, 124, 125, 13, 0, 1, 2, -1, -1, -1, -1, 49};
+static void keymap_start(void) {
+    const char *map = getenv("DM_KEYMAP"); int n = 0;
+    for (const char *s = map; s && *s; s = strchr(s, ',') ? strchr(s, ',') + 1 : "") {
+        const char *eq = strchr(s, '='), *end = strchr(s, ','); if (!eq || (end && eq > end)) continue;
+        int code = atoi(eq + 1);
+        for (int k = 0; k < KM_N; k++) if ((size_t)(eq - s) == strlen(km_names[k]) && !strncasecmp(s, km_names[k], eq - s) && code >= -1 && code < 128) { g_km[k] = code; n++; }
     }
-    return -1;
+    if (map) LOG("front end: keyboard map from DM_KEYMAP (%d key(s) changed)", n);
 }
